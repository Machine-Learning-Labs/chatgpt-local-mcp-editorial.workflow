# Headless Scribus + caewa/scribus-mcp (https://github.com/caewa/scribus-mcp), served over
# Streamable HTTP on :8000/mcp. Only the gateway can reach it (not published on the host).
FROM docker.io/library/debian:trixie-slim

# The Python set is hash-pinned in containers/scribus-mcp/requirements.txt (bin/lock), which
# also pins mcp<2 (scribus-mcp 1.3.x imports mcp.server.fastmcp, removed in mcp 2.x).
# SCRIBUS_MCP_VERSION only tags the image and must match what the file pins.
ARG SCRIBUS_MCP_VERSION=1.3.1
ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SCRIBUS_BIN=/usr/bin/scribus \
    SCRIBUS_MCP_USE_XVFB=1

COPY containers/scribus-mcp/requirements.txt /tmp/requirements.txt
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      scribus xvfb xauth ghostscript fontconfig fonts-dejavu fonts-liberation2 \
      python3 python3-venv ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && grep -qE "^scribus-mcp==${SCRIBUS_MCP_VERSION}( |$)" /tmp/requirements.txt \
 && python3 -m venv /opt/venv \
 && pip install --require-hashes -r /tmp/requirements.txt \
 && rm /tmp/requirements.txt \
 && useradd --create-home --uid 10001 scribus \
 && mkdir -p /workspace && chown scribus /workspace

USER scribus
WORKDIR /workspace
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
  CMD python -c "import socket; socket.create_connection(('127.0.0.1', 8000), 2)" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "scribus-mcp"]
# Binds 0.0.0.0 so the gateway container can connect; the gateway sends Host: localhost
# (UPSTREAM_HOST_HEADER) to satisfy FastMCP's DNS-rebinding check.
CMD ["--http", "0.0.0.0:8000"]

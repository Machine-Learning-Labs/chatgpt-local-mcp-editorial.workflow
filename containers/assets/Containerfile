# Editorial Assets MCP server: brings images from ChatGPT into EDITORIAL_ROOT.
FROM docker.io/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install ".[assets]" && useradd --system --uid 10002 assets

USER assets
EXPOSE 8766
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"ASSETS_PORT\",\"8766\")}/healthz', timeout=2)" || exit 1

ENTRYPOINT ["editorial-assets"]
CMD ["serve"]

#!/usr/bin/env bash
# One command: setup → preflight → (host mode: scribus-mcp service) → stack → URL + token.
#
#   bin/up             build and start
#   bin/up --no-build  start with existing images
#
# Host mode: if the systemd unit is not installed, scribus-mcp is started as a TRANSIENT
# unit and bin/down removes it again, so nothing stays on the machine between sessions.
source "$(dirname "$0")/lib.sh"

BUILD=(--build)
[[ "${1:-}" == "--no-build" ]] && BUILD=()

"$ROOT/bin/setup"
"$ROOT/bin/check" || die "fix the problems above and retry"

mode="$(mcp_mode)"
if [[ "$mode" == "host" ]]; then
  "$ROOT/bin/host-service" start
fi

info "starting stack ($(compose_cmd), mode $mode)"
compose up -d ${BUILD[@]+"${BUILD[@]}"} --remove-orphans

wait_for "gateway healthy" 90 curl -fsS "$(gateway_local_url)/healthz" || die "gateway did not start (make logs s=gateway)"
if [[ "$mode" == "container" ]]; then
  wait_for "scribus-mcp ready" 120 compose exec -T scribus-mcp \
    python -c "import socket; socket.create_connection(('127.0.0.1', 8000), 2)" \
    || warn "scribus-mcp is not ready yet (make logs s=scribus-mcp)"
fi
wait_for "ngrok tunnel up" 60 public_url || warn "ngrok has no URL yet (make logs s=ngrok)"

echo
"$ROOT/bin/token"
echo
if [[ "$mode" == "host" ]]; then
  info "open your Scribus with the bridge: make scribus  ·  files live in $(editorial_root)"
fi
info "consent password: GATEWAY_OWNER_PASSWORD in .env · status: make check-live · stop: make down"

#!/usr/bin/env bash
# Stop the stack. In host mode also stop scribus-mcp if it was started as a transient
# unit by bin/up (an installed unit keeps running unless --all is given).
#
#   bin/down           stop containers (+ transient scribus-mcp)
#   bin/down --all     also stop an installed scribus-mcp unit
source "$(dirname "$0")/lib.sh"

compose down --remove-orphans
if [[ "$(mcp_mode)" == "host" ]] && have systemctl; then
  if [[ "${1:-}" == "--all" ]] || "$ROOT/bin/host-service" is-transient; then
    "$ROOT/bin/host-service" stop
  fi
fi
ok "stopped"

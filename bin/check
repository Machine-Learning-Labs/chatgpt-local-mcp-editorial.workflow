#!/usr/bin/env bash
# Preflight (default) and live end-to-end checks.
#
#   bin/check          tools, .env, editorial folder, host prerequisites, ports, compose file
#   bin/check --live   running stack: health, OAuth metadata, 401 challenge, policy, MCP
#                      initialize through the gateway and through the public ngrok URL,
#                      host mode: service bound to loopback, Scribus bridge reachable
source "$(dirname "$0")/lib.sh"

LIVE=0
[[ "${1:-}" == "--live" ]] && LIVE=1
[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { sed -n '2,6p' "$0"; exit 0; }
ERRORS=0
err() { fail "$*"; ERRORS=$((ERRORS + 1)); }

preflight() {
  info "tools"
  local cmd
  if cmd="$(compose_cmd)"; then ok "compose: $cmd ($(engine))"; else err "install docker compose or podman-compose"; fi
  have curl && ok "curl" || err "curl is required"
  have ngrok && ok "ngrok CLI $(ngrok version 2>/dev/null | awk '{print $3}') (optional, the stack uses the ngrok image)" \
    || warn "ngrok CLI not installed (optional)"
  if have scribus; then
    ok "local $(scribus --version 2>/dev/null | grep -i version | head -n1 || echo Scribus) (used in host mode)"
  else
    [[ "$(mcp_mode)" == "host" ]] && err "MCP_MODE=host but scribus is not installed" \
      || warn "scribus not installed locally (fine in container mode)"
  fi

  info "configuration (.env)"
  [[ -f "$ENV_FILE" ]] || { err ".env missing: run bin/setup"; return; }
  local perms; perms="$(stat -c %a "$ENV_FILE" 2>/dev/null || stat -f %Lp "$ENV_FILE")"
  [[ "$perms" == "600" ]] && ok ".env permissions 600" || warn ".env permissions are $perms (chmod 600 .env)"
  local secret; secret="$(env_get GATEWAY_SECRET)"
  (( ${#secret} >= 32 )) && ok "GATEWAY_SECRET set" || err "GATEWAY_SECRET missing/short: run bin/setup"
  if [[ "$(env_get GATEWAY_AUTO_APPROVE false)" == "true" ]]; then
    warn "GATEWAY_AUTO_APPROVE=true: anyone with the URL can get a token"
  else
    [[ -n "$(env_get GATEWAY_OWNER_PASSWORD)" ]] && ok "owner password set" || err "GATEWAY_OWNER_PASSWORD missing"
  fi
  [[ -n "$(env_get NGROK_AUTHTOKEN)" ]] && ok "NGROK_AUTHTOKEN set" || err "NGROK_AUTHTOKEN missing"
  [[ -n "$(env_get NGROK_DOMAIN)" ]] && ok "static domain $(env_get NGROK_DOMAIN)" \
    || warn "no NGROK_DOMAIN: the URL changes on each restart (clients must reconnect)"

  local root; root="$(editorial_root)"
  if [[ "$root" != /* ]]; then err "EDITORIAL_ROOT must be absolute (got $root)"
  elif ! root_is_dedicated "$root"; then err "EDITORIAL_ROOT=$root is not a dedicated folder (never /, \$HOME or a parent of it)"
  elif [[ -d "$root" ]]; then
    local rperm; rperm="$(stat -c %a "$root")"
    [[ "$rperm" == 700 ]] && ok "editorial folder $root (700)" || warn "editorial folder $root has permissions $rperm (chmod 700)"
  else err "editorial folder $root missing: run bin/setup"; fi
  [[ -z "$(env_get GATEWAY_ALLOWED_CLIENT_CIDRS)" ]] \
    && warn "GATEWAY_ALLOWED_CLIENT_CIDRS empty: any IP can call the MCP endpoints with a valid token (see docs/security.md)"

  info "single-user machine"
  local others; others="$(other_login_users)"
  if [[ -z "$others" ]]; then
    ok "no other login accounts (scribus-mcp and the assets server trust every local process)"
  else
    warn "other login accounts on this machine: ${others% }. They can reach scribus-mcp on 127.0.0.1 without the gateway's policy (docs/security.md, 'Other users on this machine')"
  fi

  local mode; mode="$(mcp_mode)"
  case "$mode" in
    container) ok "MCP mode container (scribus-mcp $(env_get SCRIBUS_MCP_VERSION 1.3.1), headless Scribus)" ;;
    host) host_preflight ;;
    *) err "MCP_MODE must be container or host (got $mode)" ;;
  esac
  designcraft_preflight

  info "ports"
  local port; port="$(env_get GATEWAY_PORT 8080)"
  if curl -fsS -o /dev/null "http://127.0.0.1:$port/healthz" 2>/dev/null; then ok "gateway already running on $port"
  elif (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then err "port $port is busy (set GATEWAY_PORT)"
  else ok "port $port free"; fi

  info "compose file"
  if compose config -q >/dev/null 2>&1; then ok "docker-compose.yml valid"; else err "compose config failed: $(compose config -q 2>&1 | tail -n2)"; fi
}

host_preflight() {
  ok "MCP mode host: scribus-mcp as systemd user service on 127.0.0.1:$(env_get HOST_MCP_PORT 8765)"
  [[ "$(uname -s)" == Linux ]] || err "host mode needs Linux (network_mode: host)"
  have systemd-run && systemctl --user show-environment >/dev/null 2>&1 \
    && ok "systemd user manager available" || err "systemd user manager not available"
  local data="${EWF_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/editorial-workflow}"
  if [[ -x "$data/scribus-mcp-$(env_get SCRIBUS_MCP_VERSION 1.3.1)/bin/scribus-mcp" ]]; then
    ok "scribus-mcp runtime built ($data)"
  elif uv="$(find_uv)"; then ok "uv found to build the runtime on first start ($uv)"
  else err "uv is needed once to build the scribus-mcp runtime: curl -LsSf https://astral.sh/uv/install.sh | sh (or UV=/path/to/uv in .env)"; fi
  if have scribus; then
    local qt want
    qt="$(ldd "$(command -v scribus)" 2>/dev/null | grep -oE 'libQt[56]Core' | head -n1 || true)"
    want=PyQt5; [[ "$qt" == libQt6Core ]] && want=PyQt6
    /usr/bin/python3 -c "import ${want}.QtCore" 2>/dev/null \
      && ok "${want} available to Scribus' Python (bridge keeps the GUI responsive)" \
      || warn "${want} missing: Scribus freezes while the bridge runs → sudo apt install python3-$(tr '[:upper:]' '[:lower:]' <<<"$want")"
  fi
  if "$ROOT/bin/host-service" is-transient 2>/dev/null || systemctl --user is-active --quiet "${HOST_SERVICE_NAME:-editorial-scribus-mcp}"; then
    ok "scribus-mcp service already running"
  elif (exec 3<>"/dev/tcp/127.0.0.1/$(env_get HOST_MCP_PORT 8765)") 2>/dev/null; then
    err "port $(env_get HOST_MCP_PORT 8765) is busy (HOST_MCP_PORT)"
  fi
}

designcraft_preflight() {
  local cli want found port
  cli="$(env_get DESIGNCRAFT_CLI /usr/bin/designcraft-cli)"
  if ! designcraft_enabled; then
    [[ -x "$cli" ]] && info "DesignCraft is installed: set DESIGNCRAFT_ENABLED=true for a third connector (docs/designcraft.md)"
    return 0
  fi
  [[ "$(mcp_mode)" == "host" ]] || { err "DESIGNCRAFT_ENABLED=true needs MCP_MODE=host"; return; }
  [[ -x "$cli" ]] || { err "designcraft-cli not found at $cli (install DesignCraft or set DESIGNCRAFT_CLI)"; return; }
  want="$(env_get DESIGNCRAFT_VERSION 0.20.1)"
  found="$("$cli" --version 2>/dev/null | awk '{print $2}')"
  [[ "$found" == "$want" ]] && ok "designcraft-cli $found (the version the gateway policy was reviewed for)" \
    || err "designcraft-cli is $found, the policy was reviewed for $want: run bin/designcraft-audit (docs/designcraft.md)"
  port="$(env_get DESIGNCRAFT_PORT 8767)"
  local others=("$(env_get GATEWAY_PORT 8080)" "$(env_get HOST_MCP_PORT 8765)" "$(env_get ASSETS_PORT 8766)")
  [[ " ${others[*]} " == *" $port "* ]] && err "DESIGNCRAFT_PORT=$port is already used by another service"
  if "$ROOT/bin/designcraft-service" is-transient 2>/dev/null \
    || systemctl --user is-active --quiet "${DESIGNCRAFT_SERVICE_NAME:-editorial-designcraft-mcp}"; then
    ok "DesignCraft service already running"
  elif (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
    err "port $port is busy (DESIGNCRAFT_PORT)"
  else
    ok "DesignCraft: mcp-proxy + designcraft-cli (headless, confined to $(editorial_root)) on 127.0.0.1:$port"
  fi
}

mcp_initialize() { # url token
  curl -fsS -X POST "$1" \
    -H "Authorization: Bearer $2" -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' \
    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"bin/check","version":"1"}}}'
}

mcp_call() { # url token params-json — stateless call (no session) is enough for the policy
  curl -sS -X POST "$1" \
    -H "Authorization: Bearer $2" -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' \
    -d "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":$3}"
}

host_live() {
  local port listeners disc
  port="$(env_get HOST_MCP_PORT 8765)"
  "$ROOT/bin/host-service" status | sed 's/^/     /'
  listeners="$(ss -Hltn "sport = :$port" 2>/dev/null | awk '{print $4}')"
  if [[ -z "$listeners" ]]; then err "scribus-mcp is not listening on :$port"
  elif grep -qvE '^(127\.0\.0\.1|\[::1\]):' <<<"$listeners"; then err "scribus-mcp listens beyond loopback: $listeners"
  else ok "scribus-mcp bound to loopback only ($listeners)"; fi
  listeners="$(ss -Hltn "sport = :$(env_get GATEWAY_PORT 8080)" 2>/dev/null | awk '{print $4}')"
  grep -qvE '^(127\.0\.0\.1|\[::1\]):' <<<"$listeners" && err "gateway listens beyond loopback: $listeners" \
    || ok "gateway bound to loopback only"
  disc="${XDG_RUNTIME_DIR:-/tmp}/scribus-mcp/scribus-mcp.json"
  if [[ -f "$disc" ]]; then
    [[ "$(stat -c %a "$disc")" == 600 ]] && ok "bridge discovery file is private (600)" || err "bridge discovery file is not 600"
    grep -q 'qt=NONE\|no Qt binding' <(tail -n3 "${disc%/*}/bridge.log" 2>/dev/null) \
      && warn "bridge running without Qt binding (GUI freezes): sudo apt install python3-pyqt5" \
      || ok "bridge running with a Qt binding"
  else
    warn "no Scribus bridge running: make scribus (calls will use headless Scribus)"
  fi
}

assets_live() {
  local local_url="$1" token body code listeners
  code="$(curl -s -o /dev/null -w '%{http_code}' -X POST "$local_url/assets/mcp")"
  [[ "$code" == "401" ]] && ok "/assets/mcp without token → 401" || err "/assets/mcp without token returned $code"
  token="$("$ROOT/bin/token" --quiet --local --assets)" || { err "could not mint an assets token"; return; }
  body="$(curl -sS -X POST "$local_url/editor/mcp" -H "Authorization: Bearer $token" -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' -d '{}' -o /dev/null -w '%{http_code}')"
  [[ "$body" == "401" ]] && ok "assets token rejected by the Scribus connector (separate audience)" \
    || err "assets token accepted by /editor/mcp ($body)"
  body="$(curl -sS -X POST "$local_url/assets/mcp" -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' -d '{"jsonrpc":"2.0","id":2,"method":"tools/list"}' || true)"
  if grep -q '"import_image"' <<<"$body" && grep -q 'openai/fileParams' <<<"$body"; then
    ok "assets connector: import_image (openai/fileParams), list_assets, request_image_upload"
  else
    err "assets connector tools/list failed (make logs s=assets)"
  fi
  body="$(mcp_call "$local_url/assets/mcp" "$token" '{"name":"list_assets","arguments":{"folder":"/etc"}}' || true)"
  grep -q 'Refused' <<<"$body" && ok "assets policy: folder outside $(editorial_root) refused" \
    || err "assets policy did NOT refuse /etc"
  if [[ "$(mcp_mode)" == "host" ]]; then
    listeners="$(ss -Hltn "sport = :$(env_get ASSETS_PORT 8766)" 2>/dev/null | awk '{print $4}')"
    if [[ -z "$listeners" ]]; then err "assets is not listening on :$(env_get ASSETS_PORT 8766)"
    elif grep -qvE '^(127\.0\.0\.1|\[::1\]):' <<<"$listeners"; then err "assets listens beyond loopback: $listeners"
    else ok "assets bound to loopback only ($listeners)"; fi
  fi
}

designcraft_live() {
  local local_url="$1" token body code listeners
  code="$(curl -s -o /dev/null -w '%{http_code}' -X POST "$local_url/designcraft/mcp")"
  [[ "$code" == "401" ]] && ok "/designcraft/mcp without token → 401" || err "/designcraft/mcp without token returned $code"
  token="$("$ROOT/bin/token" --quiet --local --designcraft)" || { err "could not mint a DesignCraft token"; return; }
  code="$(curl -sS -X POST "$local_url/editor/mcp" -H "Authorization: Bearer $token" -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' -d '{}' -o /dev/null -w '%{http_code}')"
  [[ "$code" == "401" ]] && ok "DesignCraft token rejected by the Scribus connector (separate audience)" \
    || err "DesignCraft token accepted by /editor/mcp ($code)"
  body="$(curl -sS -X POST "$local_url/designcraft/mcp" -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' -d '{"jsonrpc":"2.0","id":2,"method":"tools/list"}' || true)"
  if grep -q '"render_page"' <<<"$body" && ! grep -q '"name": *"key"' <<<"$body"; then
    ok "DesignCraft connector: reviewed tools only (key and window tools hidden)"
  else
    err "DesignCraft tools/list failed or shows unreviewed tools (bin/designcraft-service logs)"
  fi
  body="$(mcp_call "$local_url/designcraft/mcp" "$token" '{"name":"open_document","arguments":{"path":"/etc/passwd"}}' || true)"
  grep -q 'Refused' <<<"$body" && ok "DesignCraft policy: path outside $(editorial_root) refused" \
    || err "DesignCraft policy did NOT refuse /etc/passwd"
  body="$(mcp_call "$local_url/designcraft/mcp" "$token" '{"name":"execute","arguments":{"command":"file.print","params":{"dryRun":true}}}' || true)"
  grep -q 'Refused' <<<"$body" && ok "DesignCraft policy: file.print refused" || err "DesignCraft policy did NOT refuse file.print"
  body="$(mcp_call "$local_url/designcraft/mcp" "$token" '{"name":"key","arguments":{"key":"P","cmd":true}}' || true)"
  grep -q 'Refused' <<<"$body" && ok "DesignCraft policy: key (command shortcuts) refused" || err "DesignCraft policy did NOT refuse key"
  listeners="$(ss -Hltn "sport = :$(env_get DESIGNCRAFT_PORT 8767)" 2>/dev/null | awk '{print $4}')"
  if [[ -z "$listeners" ]]; then err "DesignCraft is not listening on :$(env_get DESIGNCRAFT_PORT 8767)"
  elif grep -qvE '^(127\.0\.0\.1|\[::1\]):' <<<"$listeners"; then err "DesignCraft listens beyond loopback: $listeners"
  else ok "DesignCraft bound to loopback only ($listeners)"; fi
}

live() {
  local local_url public token body code
  local_url="$(gateway_local_url)"
  info "live checks"
  curl -fsS "$local_url/healthz" >/dev/null && ok "gateway healthy at $local_url" || { err "gateway not reachable (make up?)"; return; }
  curl -fsS "$local_url/.well-known/oauth-authorization-server" | grep -q '"code_challenge_methods_supported"' \
    && ok "OAuth metadata served" || err "OAuth metadata missing"
  code="$(curl -s -o /dev/null -w '%{http_code}' -X POST "$local_url/editor/mcp")"
  [[ "$code" == "401" ]] && ok "/editor/mcp without token → 401" || err "/editor/mcp without token returned $code"

  token="$("$ROOT/bin/token" --quiet --local)" || { err "could not mint a token"; return; }
  if body="$(mcp_initialize "$local_url/editor/mcp" "$token")" && grep -q '"serverInfo"' <<<"$body"; then
    ok "MCP initialize through gateway: $(grep -oE '"serverInfo": ?\{[^}]*\}' <<<"$body" | head -n1)"
  else
    err "MCP initialize through gateway failed (upstream down? make logs)"
  fi
  body="$(mcp_call "$local_url/editor/mcp" "$token" '{"name":"save_document_as","arguments":{"path":"/etc/editorial-check.sla"}}' || true)"
  grep -q 'Refused' <<<"$body" && ok "policy: path outside $(editorial_root) refused" \
    || err "policy did NOT refuse a path outside the editorial folder"
  body="$(mcp_call "$local_url/editor/mcp" "$token" '{"name":"run_script","arguments":{}}' || true)"
  grep -q 'Refused' <<<"$body" && ok "policy: run_script refused" || err "policy did NOT refuse run_script"
  [[ "$(mcp_mode)" == "host" ]] && host_live "$local_url" "$token"
  assets_live "$local_url"
  designcraft_enabled && [[ "$(mcp_mode)" == "host" ]] && designcraft_live "$local_url"

  if public="$(public_url)"; then
    code="$(curl -s -o /dev/null -w '%{http_code}' "$public/.well-known/oauth-protected-resource")"
    [[ "$code" == "200" ]] && ok "public URL $public" || err "public URL $public returned $code"
    token="$("$ROOT/bin/token" --quiet)"
    if body="$(mcp_initialize "$public/editor/mcp" "$token")" && grep -q '"serverInfo"' <<<"$body"; then
      ok "MCP initialize through ngrok"
      token="$("$ROOT/bin/token" --quiet --assets)"
      body="$(mcp_initialize "$public/assets/mcp" "$token" || true)"
      grep -q '"serverInfo"' <<<"$body" && ok "assets initialize through ngrok" || err "assets initialize through ngrok failed"
      if designcraft_enabled && [[ "$(mcp_mode)" == "host" ]]; then
        token="$("$ROOT/bin/token" --quiet --designcraft)"
        body="$(mcp_initialize "$public/designcraft/mcp" "$token" || true)"
        grep -q '"serverInfo"' <<<"$body" && ok "DesignCraft initialize through ngrok" || err "DesignCraft initialize through ngrok failed"
      fi
    else
      err "MCP initialize through ngrok failed"
    fi
  else
    err "no public URL from ngrok (make logs s=ngrok)"
  fi
}

preflight
(( LIVE )) && live
if (( ERRORS )); then fail "$ERRORS problem(s) found"; exit 1; fi
ok "all checks passed"

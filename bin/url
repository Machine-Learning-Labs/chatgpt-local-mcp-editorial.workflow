#!/usr/bin/env bash
# Print the public connector URLs (Scribus MCP, Editorial Assets and, if enabled, DesignCraft).
source "$(dirname "$0")/lib.sh"
url="$(public_url)" || die "no public URL (is ngrok running? make logs s=ngrok)"
echo "editor: $url/editor/mcp"
echo "assets:  $url/assets/mcp"
if designcraft_enabled && [[ "$(mcp_mode)" == host ]]; then echo "designcraft: $url/designcraft/mcp"; fi

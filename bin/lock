#!/usr/bin/env bash
# Pin every dependency, with hashes, so that what runs is what was reviewed:
#
#   uv.lock                                   the project: gateway, assets, dev tools
#   containers/gateway/requirements.txt       gateway image            (uv export)
#   containers/assets/requirements.txt        assets image             (uv export --extra assets)
#   containers/scribus-mcp/requirements.in    scribus-mcp==SCRIBUS_MCP_VERSION + mcp<2
#   containers/scribus-mcp/requirements.txt   host runtime venv + image (uv pip compile)
#
# Run it after changing pyproject.toml or SCRIBUS_MCP_VERSION, then commit the files.
# CI audits the pinned sets with pip-audit, and Dependabot proposes updates.
source "$(dirname "$0")/lib.sh"

uv="$(find_uv)" || die "uv is required: curl -LsSf https://astral.sh/uv/install.sh | sh (or UV=/path/to/uv in .env)"
cd "$ROOT"

# env -u: an active conda env or venv must not leak into the resolution.
run_uv() { env -u VIRTUAL_ENV -u CONDA_PREFIX -u PYTHONPATH -u PYTHONHOME "$uv" "$@"; }

run_uv lock --quiet
ok "uv.lock"
run_uv export --quiet --frozen --no-emit-project -o containers/gateway/requirements.txt
run_uv export --quiet --frozen --no-emit-project --extra assets -o containers/assets/requirements.txt
ok "containers/gateway/requirements.txt, containers/assets/requirements.txt"

version="$(env_get SCRIBUS_MCP_VERSION 1.3.1)"
{
  echo "# Generated by bin/lock from SCRIBUS_MCP_VERSION; edit .env and run: make lock"
  echo "scribus-mcp==${version}"
  echo "# scribus-mcp 1.3.x imports mcp.server.fastmcp, which mcp 2.x removed."
  echo "mcp>=1.10,<2"
} >containers/scribus-mcp/requirements.in
run_uv pip compile --quiet --universal --generate-hashes --python-version 3.11 \
  containers/scribus-mcp/requirements.in -o containers/scribus-mcp/requirements.txt
ok "containers/scribus-mcp/requirements.txt (scribus-mcp ${version})"

# Copy to .env (bin/setup does it and fills the secrets for you). Never commit .env.

# ── ngrok ──────────────────────────────────────────────────────────────────────
# bin/setup imports it from `ngrok config` if you already ran `ngrok config add-authtoken`.
NGROK_AUTHTOKEN=
# Your static domain (free accounts get one: dashboard → Domains), e.g. foo-bar.ngrok-free.app
# Empty = random URL that changes on every restart (clients must re-register).
NGROK_DOMAIN=

# ── OAuth gateway ──────────────────────────────────────────────────────────────
# HMAC key for every token. Rotating it (make rotate) revokes all tokens and clients.
GATEWAY_SECRET=
# Password asked on the consent screen when a client (Claude, ChatGPT…) connects.
GATEWAY_OWNER_PASSWORD=
# true = no consent screen. Only for local tests: anyone with the URL gets a token.
GATEWAY_AUTO_APPROVE=false
# Public origin. Empty = derived from the request (works with ngrok out of the box).
PUBLIC_URL=
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
GATEWAY_PORT=8080
GATEWAY_CORS_ORIGINS=*
# Redirect URIs a client may register with (scheme+host exact, then path prefix).
# "none" = any https / loopback / private-scheme URI.
GATEWAY_ALLOWED_REDIRECTS=https://chatgpt.com/,https://claude.ai/,https://claude.com/,http://localhost,http://127.0.0.1
# Only these client IPs may call /mcp, /token and /register (empty = any). For ChatGPT
# only, paste OpenAI's published connector egress ranges here (see docs/security.md).
GATEWAY_ALLOWED_CLIENT_CIDRS=

# ── Tool policy (enforced by the gateway on every call) ─────────────────────────
# The ONLY folder the MCP may read/write. Every path argument must resolve inside it
# (symlinks included). Mounted at the same absolute path in every container.
EDITORIAL_ROOT=
# Hidden + refused tools. "none" disables the deny list (not recommended).
POLICY_DENY_TOOLS=run_script,install_custom_font,set_js_action,create_pdf_push_button
# Non-empty = only these tools are exposed (comma separated).
POLICY_ALLOW_TOOLS=

# ── Scribus MCP (https://github.com/caewa/scribus-mcp) ─────────────────────────
# host      = scribus-mcp is a systemd user service on this machine (bin/host-service)
#             and drives YOUR Scribus window through its bridge (make scribus). Linux only.
# container = headless Scribus 1.6 + scribus-mcp inside the stack (batch work, PDFs)
MCP_MODE=host
# PyPI version of scribus-mcp (host runtime venv and container image tag)
SCRIBUS_MCP_VERSION=1.3.1
SCRIBUS_MCP_LOG_LEVEL=INFO
# Host mode: loopback port of the scribus-mcp service
HOST_MCP_PORT=8765

# Container engine override: "docker compose", "podman compose" or "podman-compose"
COMPOSE=
